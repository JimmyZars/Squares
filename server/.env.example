# Copy this file to server/.env and fill in your NEW MongoDB Atlas credentials.
# Atlas -> Cluster0 -> Connect -> Drivers gives the real hostname.
# URL-encode special characters in the password (for example # becomes %23).
MONGODB_URI=mongodb+srv://iamjfz:<URL_ENCODED_NEW_PASSWORD>@<YOUR_CLUSTER0_HOSTNAME>/squares?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:3000
PORT=5000
