# Copy to server/.env for local development. Never commit your actual credentials.
# In Vercel Settings > Environment Variables set MONGODB_URI instead.
# Copy the full connection string from Atlas > Squares > Cluster0 > Connect > Drivers.
# Rotate the previously shared password; URL-encode any special characters.
MONGODB_URI=mongodb+srv://iamjfz:<ENCODED_NEW_PASSWORD>@<ATLAS_HOSTNAME>/squares?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:3000
PORT=5000
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
